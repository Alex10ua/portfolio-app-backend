spring.application.name=alex
spring.mongodb.authentication-database=user
spring.mongodb.username=user
spring.mongodb.password=password
spring.mongodb.database=portfolio
spring.mongodb.port=27017
spring.mongodb.host=localhost
spring.data.mongodb.auto-index-creation=true
# swagger-ui custom path
springdoc.swagger-ui.path=/swagger-ui.html
app.rest.base-url=http://localhost:5000
server.error.include-message=never
server.error.include-stacktrace=never
server.error.include-exception=false
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=strict
